<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_loading" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.loading</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Loading Animation" string="Loading Animation" name="sm_loading_animation" logo="/sm_loading_animation/static/description/icon.png">
                    <block title="Custom Loading Animation">
                        <setting>
                            <label for="sm_loading_animation_type"/>
                            <div class="text-muted">Choose animation type</div>
                            <field name="sm_loading_animation_type" class="mt-2"/>
                        </setting>
                        <setting>
                            <label for="sm_loading_position"/>
                            <div class="text-muted">Position on screen</div>
                            <field name="sm_loading_position" class="mt-2"/>
                        </setting>
                        <setting>
                            <label for="sm_loading_color" string="Primary Color"/>
                            <field name="sm_loading_color" widget="color"/>
                        </setting>
                        <setting>
                            <label for="sm_loading_bg_color" string="Background Color"/>
                            <field name="sm_loading_bg_color" widget="color"/>
                        </setting>
                        <setting>
                            <field name="sm_loading_show_text"/>
                            <!-- <label for="sm_loading_show_text"/> -->
                            <div class="content-group mt-2" invisible="not sm_loading_show_text">
                                <field name="sm_loading_text" placeholder="Loading..."/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
