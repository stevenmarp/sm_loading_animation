<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sm_loading_animation.LoadingOverlay">
        <div class="sm-loading-overlay" t-if="props.visible">
            <div class="sm-loading-overlay-backdrop"/>
            <div class="sm-loading-overlay-content">
                <div class="sm-loading-spinner">
                    <div class="sm-spinner-ring"></div>
                    <div class="sm-spinner-ring sm-delay-1"></div>
                    <div class="sm-spinner-ring sm-delay-2"></div>
                </div>
                <div class="sm-loading-overlay-text">
                    Loading...
                </div>
            </div>
        </div>
    </t>

</templates>
